{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run pxl:*)",
      "Bash(npm run new:*)",
      "Bash(npm run dev:*)",
      "Bash(node .claude/skills/claude-pxl/bin/pxl.js:*)",
      "Bash(node scripts/build.js:*)",
      "Bash(node scripts/check.js:*)",
      "Bash(node scripts/new-asset.js:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(assets/**)",
      "Read(library/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check.js\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
